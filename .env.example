# SILENCE ENGINE configuration. Copy to .env and edit. Real environment variables override this file.
# Never commit a real .env.

# Where the SQLite database, synthetic CSV and (separate) label file live.
SILENCE_DATA_DIR=./data
# SILENCE_DB_PATH=./data/silence_engine.sqlite3
# SILENCE_LABELS_PATH=./data/synthetic/ground_truth_labels.json
# SILENCE_FRONTEND_DIST=./frontend/dist

# Bind to loopback by default; reach a remote server through an SSH tunnel.
SILENCE_HOST=127.0.0.1
SILENCE_PORT=8000

# Optional free-text label shown on the Platform page (marked as unverified).
# The architecture itself is always read from the running interpreter.
# SILENCE_DEPLOYMENT_LABEL=LinuxONE Community Cloud VM

# Optional bearer token for write endpoints (generate demo data, import, reviews).
# If unset, writes are only accepted from loopback clients. If you put a reverse
# proxy in front of the app you MUST set this. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SILENCE_API_TOKEN=

# Allow a frontend dev server on another origin to call the API (exact origins, comma-separated).
# Off by default; same-origin use (dashboard served by this backend, or the Vite proxy) needs nothing.
# SILENCE_CORS_ORIGINS=http://localhost:3000

# Replace the Content-Security-Policy (only if a different frontend needs it; the default forbids inline scripts).
# SILENCE_CSP=default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'

# Generate the synthetic demo automatically when the database is empty.
SILENCE_AUTO_INIT_DEMO=1
SILENCE_DEMO_SEED=42
# Set to 0 to skip the ~11 s operational-delay replay during evaluation.
SILENCE_EVAL_REPLAY=1
# Optional ML triage benchmark (needs numpy + scikit-learn; see requirements-ml.txt). It runs after the demo data is
# generated when those packages can be imported, and is reported as "not available" otherwise. 0 switches it off.
SILENCE_ML_TRIAGE=1

SILENCE_LOG_LEVEL=INFO
SILENCE_MAX_UPLOAD_MB=10
SILENCE_MAX_IMPORT_ROWS=200000

# Scripts only (not read by the app): allow install.sh/run.sh as root inside a single-user container
# such as a Jupyter image. Never set this on a normal server.
# SILENCE_ALLOW_ROOT=1
# Scripts only: make install.sh's venv see the interpreter's own packages (the LinuxONE ML image's scikit-learn/numpy);
# use together with PYTHON=<that interpreter>. Only applies when the venv is first created.
# SILENCE_VENV_SYSTEM_SITE=1
